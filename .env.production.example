# 영문·숫자만 사용하고 서로 다른 긴 무작위 값을 지정하세요.
POSTGRES_PASSWORD=replaceWithRandomOwnerPassword
APP_DB_PASSWORD=replaceWithDifferentRandomAppPassword
ATLAS_PORT=3002

# 외부 HTTPS 출처(경로와 마지막 / 제외)와 별도로 생성한 계정 및 비밀번호 해시
APP_ORIGIN=https://replace-with-your-hostname
AUTH_USERNAME=replace-with-username
AUTH_PASSWORD_HASH=replace-with-generated-scrypt-hash
AUTH_SESSION_DAYS=30
