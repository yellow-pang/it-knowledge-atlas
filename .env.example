# 개발 전용 값. .env.local에 복사하고 비밀번호를 교체하세요.
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://atlas_dev:replace-with-a-local-development-password@127.0.0.1:55432/atlas_dev

# 개발 환경 로그인 설정. 해시는 문서의 생성 절차를 따릅니다.
APP_ORIGIN=http://127.0.0.1:3002
AUTH_USERNAME=replace-with-local-username
AUTH_PASSWORD_HASH=replace-with-generated-scrypt-hash
AUTH_SESSION_DAYS=30
